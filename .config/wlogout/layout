{
    "label" : "lock",
    "action" : "~/.config/hypr/scripts/swaylock",
    "text" : "Lock",
    "keybind" : "l",
}

{
    "label" : "logout",
    "action" : "hyprctl dispatch exit 0",
    "text" : "Logout",
    "keybind" : "e"
}

{
    "label" : "suspend",
    "action" : "~/.config/hypr/scripts/swaylock && systemctl suspend",
    "text" : "Suspend",
    "keybind" : "u"
}

{
    "label" : "shutdown",
    "action" : "shutdown now",
    "text" : "Shutdown",
    "keybind" : "s"
}

{
    "label" : "hibernate",
    "action" : "hibernate now",
    "text" : "Hibernate",
    "keybind" : "h"
}

{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
