{
    "layer": "bottom", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 53, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 2, // Gaps between modules (4px)
    // Choose the order of the modules
    // "margin-left":25,
    // "margin-right":25,
    "margin-bottom":-11,
    //"margin-top":5,
    "modules-left": ["hyprland/workspaces", "custom/spotify"],
    "modules-right": ["cpu", "custom/updates", "network", "pulseaudio", "bluetooth","backlight", "hyprland/language", "custom/notification", "battery"],
    "modules-center": ["custom/weather", "clock"],


    // Modules

    "custom/spotify": {
        "exec": "/usr/bin/python3 .config/hypr/scripts//mediaplayer.py --player spotify",
        "format": "{}  󰓇",
        "return-type": "json",
        "on-click": "playerctl -p spotify play-pause",
        "on-scroll-up": "playerctl -p spotify next",
        "on-scroll-down": "playerctl -p spotify previous"
    },

    "custom/updates": {
        "restart-interval": 3600,
        "exec": "~/.config/hypr/scripts/arch_update.sh",
        "return-type": "json",
        "on-click": ""
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
          "notification": "<span foreground='red'><sup></sup></span>",
          "none": " ",
          "dnd-notification": "<span foreground='red'><sup></sup></span>",
          "dnd-none": " ",
          "inhibited-notification": "<span foreground='red'><sup></sup></span>",
          "inhibited-none": " ",
          "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
          "dnd-inhibited-none": " "
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "sleep 0.2; swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
      },

    "custom/weather": {
        "exec": "python ~/.config/hypr/scripts/weather.py",
        "restart-interval": 300,
        "return-type": "json",
        "on-click": "pypr toggle weather && hyprctl dispatch bringactivetotop",
        "on-click-right": "xdg-open https://openweathermap.org/city/792680"
        // "format-alt": "{alt}",
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-active": " {icon} ",
        "on-click": "activate"
    },

    "hyprland/language": {
       "format": "{shortDescription}"
    },

    "clock": {
        "timezone": "Europe/Belgrade",
        "tooltip": false,
        "interval": 60,
        "format": "{:%H:%M}",
        "max-length": 25,
        "on-click": "pypr toggle calendar && hyprctl dispatch bringactivetotop",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "month",
            "on-scroll"     : 1,
            "on-click-right": "mode",
            "format": {
                "months":     "<span color='#ebdbb2'><b>{}</b></span>",
                "days":       "<span color='#83a598'><b>{}</b></span>",
                "weekdays":   "<span color='#b8bb26'><b>{}</b></span>",
  			    "today":      "<span color='#d3869b'><b><u>{}</u></b></span>"
  		    }
  	    }
    },

    "cpu": {
        "interval":1,
        "format": "{icon0} {icon1} {icon2} {icon3} {icon4} {icon5} {icon6} {icon7}",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "on-click": "kitty --class system_monitor -e btm"

    },

    "bluetooth": {
        "format": "",
        "format-on": "",
        //"format-off": "󰂲",
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
        "on-click": "~/.config/hypr/scripts/bluetoothToggle.sh",
        "on-click-right": "blueman-manager",
        "tooltip": false,
        "interval": 1500
    },

    "backlight": {
        "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "on-scroll-down": "swayosd-client --brightness raise",
        "on-scroll-up": "swayosd-client --brightness lower",
        "format-icons": ["󰃚", "󰃚", "󰃛", "󰃜", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
        "tooltip": false
    },

    "battery": {
        "states": {
            "warning": 50,
            "critical": 20
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% {icon}󱐋",
        "format-plugged": "{capacity}% {icon}",
        "format-full": "{capacity}% 󱈑",
        "format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁", "󰂂"],
        "on-click": "wlogout --layout ~/.config/wlogout/layout --css ~/.config/wlogout/style.css -p layer-shell -b 6 -c 0 -r 0",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}󰂯",
        "format-bluetooth-muted": "󰝟 󰂯 muted",
        "format-muted": "󰝟  muted",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰏲",
            "headset": "󰋋",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click-right": "pavucontrol",
        "on-click": "swayosd-client --output-volume mute-toggle",
        "on-scroll-down": "swayosd-client --output-volume raise",
        "on-scroll-up": "swayosd-client --output-volume lower",
        "tooltip": false
    },

    "network": {
        //"interface": "wlan2",
        "format": "Wifi off 󰤭",
        "format-wifi":  "{essid} {signalStrength}% {icon}",
        "format-ethernet": "󰈀 ",
        "format-disconnected": "󰤭 ",
        "tooltip-format": "{ifname} via {gwaddr} 󰱶",
        "tooltip-format-wifi": "{essid}",
        "format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"],
        "on-click": "~/.config/rofi/rofi-network-manager/rofi-network-manager.sh",
        "tooltip": false
    }

}
